# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only URL used by Next.js BFF routes. Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Copie a URI no painel Supabase em Connect. Para Railway/FastAPI persistente,
# prefira a conexão direta; use Session pooler se o ambiente não suportar IPv6.
# Caracteres especiais da senha devem ser percent-encoded. URIs com o esquema
# postgresql:// fornecidas pelo painel são convertidas para o driver psycopg.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300

# Supabase Auth (publishable key, never a secret or service_role key)
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
WEB_ORIGIN=http://localhost:3000

# IGDB catalog (backend only; never expose these as NEXT_PUBLIC_* variables)
IGDB_CLIENT_ID=replace-me
IGDB_CLIENT_SECRET=replace-me
IGDB_TIMEOUT_SECONDS=10

# Public catalog protection. Upstash is mandatory when APP_ENVIRONMENT=production.
APP_ENVIRONMENT=development
CATALOG_VISITOR_SECRET=replace-with-at-least-32-random-characters
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
CATALOG_STORE_TIMEOUT_SECONDS=2
